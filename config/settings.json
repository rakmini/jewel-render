{
  "openai": {
    "brain_model": "gpt-4.1-mini",
    "image_model": "gpt-image-1",
    "video_model": "sora-2",
    "timeout_seconds": 120,
    "video_timeout_seconds": 600
  },
  "output": {
    "width": 1170,
    "height": 2532,
    "jpeg_quality": 95,
    "format": "jpeg"
  },
  "video": {
    "format": "mp4",
    "codec": "h264",
    "bitrate": "5000k"
  },
  "feedback": {
    "auto_add_approved_to_ril": true,
    "auto_deposit_exports_to_ril": true,
    "parameter_logging": true
  },
  "export": {
    "folder": "~/JewelRender/exports",
    "filename_pattern": "{preset}_{date}_{index}.jpg"
  },
  "ui": {
    "theme": "light",
    "preview_size": "thumbnail",
    "queue_display": "recent"
  }
}
