# Fal.AI API Key (required)
# Get yours at https://fal.ai/dashboard/keys
FAL_API_KEY=your-fal-api-key-here

# Fal.AI endpoint config (optional — defaults shown)
FAL_BASE_URL=https://fal.run/v1
FAL_MODEL=fal-ai/gpt-image-1
FAL_IMAGE_SIZE=1024x1024

# Legacy fallback: if FAL_API_KEY is unset, OPENAI_API_KEY is used instead.
# OPENAI_API_KEY=sk-...

# API Server
API_HOST=0.0.0.0
API_PORT=5050
API_DEBUG=false

# Logging
LOG_LEVEL=INFO
